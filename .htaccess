#############################################
# FunctionCool URL Rewrite & Canonical Rules #
#############################################

RewriteEngine On

# 1. 将非 www 主域 301 重定向到 www.functioncool.xyz
RewriteCond %{HTTP_HOST} ^functioncool\.xyz$ [NC]
RewriteRule ^(.*)$ https://www.functioncool.xyz/$1 [L,R=301]

# 2. 设定默认首页为 index.php
DirectoryIndex index.php

# 3. 访问 /index.php 时统一跳转到根路径 /
RewriteRule ^index\.php$ / [L,R=301]

# 3.1 Sitemap: /sitemap.xml -> sitemap.php (动态生成)
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# 4. 友好 URL: /search  -> 内部重写到 search.php (支持 /search 和 /search/)
RewriteRule ^search/?$ search.php [L,QSA]

# 6. Skill API: /skillapi -> skillapi.php (支持参数)
RewriteRule ^skillapi/?$ skillapi.php [L,QSA]

# 6a. 兼容旧链接：/mcpapi -> /skillapi (301)
RewriteRule ^mcpapi/?$ /skillapi [L,R=301,QSA]

# 7. StyleCool: style.functioncool.xyz 域名 → 委托给 stylecool/index.php（子站点，文件夹自包含可独立部署）
# 7a. 在 catch-all 之前处理 /example 路由
RewriteRule ^example/?$ stylecool/example.php [L,QSA]
RewriteCond %{HTTP_HOST} ^style\.functioncool\.xyz$ [NC]
RewriteRule ^(.*)$ stylecool/index.php [L,QSA]

# 7.1 本地/开发：/stylecool 直接访问
RewriteRule ^stylecool/?$ stylecool.php [L,QSA]
# 7.2 /stylecool/example → stylecool/example.php
RewriteRule ^stylecool/example/?$ stylecool/example.php [L,QSA]

# 6.1 文章笔记: /notes/001 -> notes/note001.php
RewriteRule ^notes/([0-9]{3,})/?$ notes/note$1.php [L,QSA]

# 6.2 规范化: 直接访问 notes/note001.php 301 到 /notes/001
RewriteCond %{THE_REQUEST} \s/+notes/note([0-9]{3,})\.php[\s?] [NC]
RewriteRule ^notes/note([0-9]{3,})\.php$ /notes/$1 [L,R=301]

# 4.1 规范化：直接访问 search.php（含查询参数） 301 到 /search
RewriteCond %{THE_REQUEST} \s/+search\.php[\s?] [NC]
RewriteRule ^search\.php$ /search [L,R=301]

# 5. 已存在的文件或目录直接放行
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 7. 404 页面直接访问: /404 -> 404.php
RewriteRule ^404/?$ 404.php [L,QSA]

# 8. 404 错误页面处理
ErrorDocument 404 /404.php

# （可选）如果需要强制 HTTPS，把下面两行取消注释
#RewriteCond %{HTTPS} !=on
#RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 说明：
# - /          -> index.php (DirectoryIndex)
# - /index.php -> 301 到 /
# - /search    -> search.php (内部重写，浏览器地址栏保持 /search)
# - /404       -> 404.php (直接访问404页面)
# - 裸域 functioncool.xyz/* -> 301 到 https://www.functioncool.xyz/*

#############################################
