        "timer_score": 90,
        "memory_score": 95,
        "code": ["import \"math\"\n\nfunc stdev(a []float64) float64 {\n    n := len(a)\n    if n < 2 { return math.NaN() }\n    m := mean(a)\n    s := 0.0\n    for _, x := range a { d := x - m; s += d * d }\n    return math.Sqrt(s / float64(n-1))\n}"]
