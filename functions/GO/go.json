        "input": ["a", "b"],
        "input_type": ["int", "int"],
        "return": ["g"],
        "return_type": ["int"],
        "timer_score": 100,
        "memory_score": 100,
        "code": ["func gcd(a, b int) int {\n    if a < 0 { a = -a }\n    if b < 0 { b = -b }\n    for b != 0 { a, b = b, a % b }\n    return a\n}"]
