        "code": ["import \"sort\"\n\nfunc median(a []float64) float64 {\n    if len(a) == 0 { return math.NaN() }\n    b := append([]float64(nil), a...)\n    sort.Float64s(b)\n    n := len(b)\n    if n%2 == 1 { return b[n/2] }\n    return (b[n/2-1] + b[n/2]) / 2\n}"]
