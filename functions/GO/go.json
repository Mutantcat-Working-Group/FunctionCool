        "input_type": ["int", "int"],
        "return": ["l"],
        "return_type": ["int"],
        "timer_score": 100,
        "memory_score": 100,
        "code": ["func lcm(a, b int) int {\n    if a == 0 || b == 0 { return 0 }\n    return abs(a*b) / gcd(a, b)\n}\n\nfunc abs(x int) int { if x < 0 { return -x }; return x }"]
