        "code": ["import java.util.*;\n\npublic double median(double[] a) {\n    if (a.length == 0) return Double.NaN;\n    double[] b = Arrays.copyOf(a, a.length);\n    Arrays.sort(b);\n    int n = b.length;\n    return (n % 2 == 1) ? b[n/2] : (b[n/2-1]+b[n/2])/2.0;\n}"]
