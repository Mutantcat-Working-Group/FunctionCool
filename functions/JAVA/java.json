        "name-zh": "标准差",
        "name-en": "Standard Deviation",
        "description-zh": "计算样本标准差",
        "description-en": "Compute sample standard deviation",
        "dependencies": [],
        "use_to": ["math"],
        "tags": ["intermediate", "math"],
        "input": ["a"],
        "input_type": ["double[]"],
        "return": ["sd"],
        "return_type": ["double"],
        "timer_score": 90,
        "memory_score": 95,
        "code": ["public double stdev(double[] a) {\n    int n = a.length;\n    if (n < 2) return Double.NaN;\n    double m = mean(a);\n    double s = 0;\n    for (double x : a) { double d = x - m; s += d*d; }\n    return Math.sqrt(s / (n - 1));\n}"]
    },
