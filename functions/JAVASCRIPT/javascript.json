    {
        "name-zh": "最大公约数",
        "name-en": "GCD",
        "description-zh": "使用欧几里得算法计算 GCD",
        "description-en": "Compute GCD via Euclid algorithm",
        "dependencies": [],
        "use_to": ["math", "number theory"],
        "tags": ["basic", "math"],
        "input": ["a", "b"],
        "input_type": ["number", "number"],
        "return": ["g"],
        "return_type": ["number"],
        "timer_score": 100,
        "memory_score": 100,
        "code": ["function gcd(a, b) {\n    a = Math.abs(a); b = Math.abs(b);\n    while (b) { const t = b; b = a % b; a = t; }\n    return a;\n}"]
    },
    {
        "name-zh": "最小公倍数",
        "name-en": "LCM",
        "description-zh": "计算 LCM",
        "description-en": "Compute LCM",
        "dependencies": [],
        "use_to": ["math", "number theory"],
        "tags": ["basic", "math"],
        "input": ["a", "b"],
        "input_type": ["number", "number"],
        "return": ["l"],
        "return_type": ["number"],
        "timer_score": 100,
        "memory_score": 100,
        "code": ["function lcm(a, b) {\n    if (a === 0 || b === 0) return 0;\n    return Math.abs(a*b) / gcd(a,b);\n}"]
    },
