    {
        "name-zh": "节流",
        "name-en": "Throttle",
        "description-zh": "限制函数在一定时间内的调用频率",
        "description-en": "Throttle a function so it runs at most once per interval",
        "dependencies": [],
        "use_to": ["performance", "event"],
        "tags": ["intermediate", "function"],
        "input": ["fn", "wait"],
        "input_type": ["Function", "number"],
        "return": ["wrapped"],
        "return_type": ["Function"],
        "timer_score": 85,
        "memory_score": 85,
        "code": ["function throttle(fn, wait) {\n    let last = 0;\n    return function(...args) {\n        const now = Date.now();\n        if (now - last >= wait) {\n            last = now;\n            return fn.apply(this, args);\n        }\n    };\n}"]
    },
