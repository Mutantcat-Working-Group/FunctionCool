        "input_type": ["Function", "number"],
        "return": ["wrapped"],
        "return_type": ["Function"],
        "timer_score": 85,
        "memory_score": 85,
        "code": ["function debounce(fn, wait) {\n    let timer = null;\n    return function(...args) {\n        clearTimeout(timer);\n        timer = setTimeout(() => fn.apply(this, args), wait);\n    };\n}"]
