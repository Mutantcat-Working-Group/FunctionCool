        "input_type": ["number[]"],
        "return": ["median"],
        "return_type": ["number"],
        "timer_score": 95,
        "memory_score": 95,
        "code": ["function median(arr) {\n    if (arr.length === 0) return NaN;\n    const a = [...arr].sort((x,y)=>x-y);\n    const n = a.length;\n    return n % 2 ? a[(n-1)/2] : (a[n/2-1] + a[n/2]) / 2;\n}"]
