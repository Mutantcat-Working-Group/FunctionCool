    {
        "name-zh": "标准差",
        "name-en": "Standard Deviation",
        "description-zh": "计算样本标准差",
        "description-en": "Compute sample standard deviation",
        "dependencies": [],
        "use_to": ["math"],
        "tags": ["intermediate", "math"],
        "input": ["arr"],
        "input_type": ["number[]"],
        "return": ["stdev"],
        "return_type": ["number"],
        "timer_score": 90,
        "memory_score": 95,
        "code": ["function stdev(arr) {\n    const n = arr.length;\n    if (n < 2) return NaN;\n    const m = mean(arr);\n    const v = arr.reduce((s,x)=>s+(x-m)*(x-m),0)/(n-1);\n    return Math.sqrt(v);\n}"]
    },
