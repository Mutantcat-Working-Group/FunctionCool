        "description-zh": "最小公倍数",
        "description-en": "Least common multiple",
        "dependencies": [],
        "use_to": ["math", "number theory"],
        "tags": ["basic", "math"],
        "input": ["a", "b"],
        "input_type": ["double", "double"],
        "return": ["l"],
        "return_type": ["double"],
        "timer_score": 100,
        "memory_score": 100,
        "code": ["function l = lcm_int(a, b)\n    a = abs(floor(a)); b = abs(floor(b));\n    if a == 0 || b == 0, l = 0; return; end\n    l = (a / gcd_int(a,b)) * b;\nend"]
    },
