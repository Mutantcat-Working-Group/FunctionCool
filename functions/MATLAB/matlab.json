        "name-zh": "主函数示例",
        "name-en": "Main Function Example",
        "description-zh": "MATLAB程序的入口函数示例，包含输入参数处理和错误处理",
        "description-en": "Entry point function example for MATLAB programs, including input arguments and error handling",
        "dependencies": [],
        "use_to": ["program entry", "input handling"],
