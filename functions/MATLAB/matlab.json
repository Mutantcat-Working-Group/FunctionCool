    {
        "name-zh": "GCD",
        "name-en": "GCD",
        "description-zh": "最大公约数",
        "description-en": "Greatest common divisor",
        "dependencies": [],
        "use_to": ["math", "number theory"],
        "tags": ["basic", "math"],
        "input": ["a", "b"],
        "input_type": ["double", "double"],
        "return": ["g"],
        "return_type": ["double"],
        "timer_score": 100,
        "memory_score": 100,
        "code": ["function g = gcd_int(a, b)\n    a = abs(floor(a)); b = abs(floor(b));\n    while b ~= 0\n        t = b; b = mod(a, b); a = t;\n    end\n    g = a;\nend"]
    },
    {
        "name-zh": "LCM",
