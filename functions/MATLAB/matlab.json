        "timer_score": 100,
        "memory_score": 100,
        "code": ["function l = lcm_int(a, b)\n    a = abs(floor(a)); b = abs(floor(b));\n    if a == 0 || b == 0, l = 0; return; end\n    l = (a / gcd_int(a,b)) * b;\nend"]
