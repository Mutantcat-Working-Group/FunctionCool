        "input": ["varargin"],
        "input_type": ["cell"],
        "return": ["status"],
        "return_type": ["double"],
        "timer_score": 100,
        "memory_score": 100,
        "code": ["function status = main(varargin)\n    try\n        % 输入参数处理\n        p = inputParser;\n        addParameter(p, 'name', 'World', @ischar);\n        parse(p, varargin{:});\n        \n        % 获取参数\n        name = p.Results.name;\n        \n        % 打印程序信息\n        fprintf('Program: %s\\n', mfilename('fullpath'));\n        \n        % 打印输入参数\n        fprintf('Arguments count: %d\\n', nargin);\n        fprintf('Arguments: ');\n        disp(varargin);\n        \n        % 程序主要逻辑\n        fprintf('Hello, %s!\\n', name);\n        \n        % 返回成功状态\n        status = 0;\n    catch ME\n        % 错误处理\n        fprintf(2, 'Error: %s\\n', ME.message);\n        if ~isempty(ME.stack)\n            fprintf(2, 'Stack trace:\\n');\n            for i = 1:length(ME.stack)\n                fprintf(2, '  File: %s, Line: %d, Function: %s\\n', ...\n                    ME.stack(i).file, ME.stack(i).line, ME.stack(i).name);\n            end\n        end\n        status = 1;\n    end\nend\n\n% 如果直接运行此文件\nif ~isempty(which('main')) && strcmp(mfilename, 'main')\n    exit(main('name', 'MATLAB'));\nend"]},
