        "input": ["a", "b"],
        "input_type": ["i64", "i64"],
        "return": ["g"],
        "return_type": ["i64"],
        "timer_score": 100,
        "memory_score": 100,
        "code": ["fn gcd(mut a: i64, mut b: i64) -> i64 {\n    a = a.abs(); b = b.abs();\n    while b != 0 { let t = b; b = a % b; a = t; }\n    a\n}"]
    },
