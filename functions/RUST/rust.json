        "return": ["l"],
        "return_type": ["i64"],
        "timer_score": 100,
        "memory_score": 100,
        "code": ["fn lcm(a: i64, b: i64) -> i64 {\n    if a == 0 || b == 0 { return 0; }\n    (a / gcd(a,b)) * b\n}"]
