        "name-zh": "中位数",
        "name-en": "Median",
        "description-zh": "计算切片的中位数",
        "description-en": "Compute median of a slice",
        "dependencies": ["std"],
        "use_to": ["math"],
        "tags": ["intermediate", "math"],
        "input": ["a"],
        "input_type": ["&[f64]"],
        "return": ["med"],
        "return_type": ["f64"],
        "timer_score": 95,
        "memory_score": 95,
        "code": ["fn median(a: &[f64]) -> f64 {\n    if a.is_empty() { return f64::NAN; }\n    let mut v = a.to_vec();\n    v.sort_by(|x,y| x.partial_cmp(y).unwrap());\n    let n = v.len();\n    if n % 2 == 1 { v[n/2] } else { (v[n/2-1] + v[n/2]) / 2.0 }\n}"]
    },
    {
        "name-zh": "标准差",
        "name-en": "Standard Deviation",
        "description-zh": "计算样本标准差",
        "description-en": "Compute sample standard deviation",
        "dependencies": ["std"],
        "use_to": ["math"],
        "tags": ["intermediate", "math"],
        "input": ["a"],
        "input_type": ["&[f64]"],
        "return": ["sd"],
        "return_type": ["f64"],
        "timer_score": 90,
        "memory_score": 95,
        "code": ["fn stdev(a: &[f64]) -> f64 {\n    if a.len() < 2 { return f64::NAN; }\n    let m = mean(a);\n    let s: f64 = a.iter().map(|x| (x - m)*(x - m)).sum();\n    (s / (a.len() as f64 - 1.0)).sqrt()\n}"]
    },
